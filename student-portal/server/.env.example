# MongoDB connection string — shared with the main app as of the phase-2
# migration (student data lives on main's Student collection now; see the
# shared-data migration notes). Do not point this at a separate database.
MONGO_URI=mongodb://localhost:27017/titan-portal

# Secrets used to sign the access/refresh JWTs — use long random strings,
# never real values, and never commit real secrets to this file.
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

PORT=5100

# The frontend's origin. Used for CORS (credentialed requests must match
# exactly, no trailing slash) and for building links (e.g. password-reset
# emails). Local dev: the Vite dev server. Production: the deployed
# frontend's URL (e.g. Vercel).
CLIENT_URL=http://localhost:5273

# Leave unset (or "development") for local dev — cookies are then
# sameSite: 'lax' + secure: false, which works over plain HTTP on
# localhost. Set to "production" only on the deployed backend (Railway),
# where the frontend is a different domain and cookies must be
# sameSite: 'none' + secure: true instead. See authController.js.
NODE_ENV=development
