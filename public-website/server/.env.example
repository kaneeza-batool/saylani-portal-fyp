# MongoDB connection string — the SAME shared database (titan-portal) the
# main app (Super Admin/Sub-Admin) and Student Portal use, not a separate
# database. This app now writes real Student/Campus documents directly
# into that shared collection (public enrollment -> pending Student ->
# Admissions Queue), so it has to be the same target those other apps
# point at, whether that's Atlas or a shared local mongod during local
# dev. Get the real value from a teammate — never invent one.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/titan-portal?retryWrites=true&w=majority

# Secret used to sign the admin JWT — use a long random string, never a
# real value, and never commit a real secret to this file.
JWT_SECRET=changeme

PORT=5200

# The frontend's origin. Used for CORS (credentialed requests must match
# exactly, no trailing slash). Local dev: the Vite dev server.
CLIENT_URL=http://localhost:5373

# Leave unset (or "development") for local dev — the admin auth cookie is
# then sameSite: 'lax' + secure: false. Set to "production" only on a
# deployed backend where the frontend is a different domain. See
# adminAuthController.js.
NODE_ENV=development

# Real SMTP credentials for application/contact confirmation emails (see
# utils/mailer.js). Leave SMTP_HOST unset to keep using an auto-provisioned
# Ethereal test inbox (dev-only — nothing is actually delivered, only
# logged to the console as a preview URL). To send real mail, set all of
# these — e.g. a Gmail account with an "app password" (not your normal
# password), or an SMTP key from SendGrid/Mailtrap/Postmark/etc:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=<app-password-or-api-key>
# SMTP_FROM="TITAN Admissions <no-reply@yourdomain.com>"

# OpenAI API key for the TITAN Assistant chat widget (controllers/
# chatController.js) — used for both the chat completions (gpt-4o-mini)
# and the retrieval embeddings (text-embedding-3-small). Without this set,
# the /api/chat endpoint returns a 503 instead of erroring out. After
# setting it, run `node scripts/buildEmbeddings.js` once (and again any
# time data/knowledgeBaseContent.js changes) to (re)generate
# data/knowledgeBaseEmbeddings.json.
OPENAI_API_KEY=
