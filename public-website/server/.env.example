# MongoDB connection string — the shared MongoDB Atlas cluster the other
# TITAN apps (Super Admin, Sub-Admin, Student Portal) also run on, using
# its own database within that cluster (titan-public), not shared
# collections. Get the real value from a teammate — never invent one.
# server.js refuses to boot if this is missing or points at
# localhost/127.0.0.1, so a local mongod is not a valid substitute even
# for local development.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/titan-public?retryWrites=true&w=majority

# Secret used to sign the admin JWT — use a long random string, never a
# real value, and never commit a real secret to this file.
JWT_SECRET=changeme

PORT=5200

# The frontend's origin. Used for CORS (credentialed requests must match
# exactly, no trailing slash). Local dev: the Vite dev server.
CLIENT_URL=http://localhost:5373

# Leave unset (or "development") for local dev — the admin auth cookie is
# then sameSite: 'lax' + secure: false. Set to "production" only on a
# deployed backend where the frontend is a different domain. See
# adminAuthController.js.
NODE_ENV=development
