# The backend's API base URL — no /api suffix, each call appends its own
# route path (see hooks/useCourses.js etc). Local dev: the Express server.
VITE_API_URL=http://localhost:5200

# Where the public site hands off to Student Portal for login / cert
# verification. Must match Student Portal's client port exactly.
VITE_STUDENT_PORTAL_URL=http://localhost:5273/login
VITE_STUDENT_PORTAL_URL_BASE=http://localhost:5273
